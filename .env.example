# Sincronización en la nube (opcional). Sin estas variables la app compila y
# funciona igual, solo que sin la opción de iniciar sesión.
#
# Son las MISMAS valores públicos que Planner expone en el navegador
# (NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY en su .env.local).
# Cópialos a un archivo .env en la raíz de este repo (ya está en .gitignore).

MAIN_VITE_SUPABASE_URL=
MAIN_VITE_SUPABASE_ANON_KEY=
